{
  "project": "WORLD SIGNALS",
  "dataset": "REVIEWED_SCENARIOS",
  "version": "0.1",
  "architecture_position": "SCENARIOS",
  "upstream_layers": [
    "RISKS_REGIMES",
    "RELATIONSHIPS",
    "SIGNALS",
    "LIVE_INTELLIGENCE",
    "CANONICAL_REGISTRY"
  ],
  "downstream_layers": ["FORECASTS"],
  "purpose": "A reviewed set of conditional possible pathways; it is not a forecast, probability ranking or asserted future outcome.",
  "layer_boundary": {
    "canonical_mutation_allowed": false,
    "observation_mutation_allowed": false,
    "signal_mutation_allowed": false,
    "relationship_mutation_allowed": false,
    "risk_state_mutation_allowed": false,
    "automatic_scenario_promotion_allowed": false,
    "forecast_fields_allowed": false,
    "probability_fields_allowed": false,
    "public_scenario_projection_allowed": false
  },
  "required_scenario_set_fields": [
    "scenario_set_id",
    "revision_id",
    "revision_number",
    "previous_revision_id",
    "title",
    "scope",
    "starting_risk_state_revisions",
    "shared_assumptions",
    "divergence_points",
    "scenario_ids",
    "temporal_scope",
    "review_state",
    "lifecycle_state",
    "first_created_at_utc",
    "effective_at_utc",
    "latest_reviewed_at_utc",
    "review_provenance",
    "revision_reason"
  ],
  "required_scenario_fields": [
    "scenario_id",
    "scenario_set_id",
    "scenario_set_revision_id",
    "revision_id",
    "revision_number",
    "previous_revision_id",
    "title",
    "description",
    "scope",
    "originating_risk_state_revisions",
    "relevant_signal_revisions",
    "relevant_relationship_revisions",
    "supporting_observation_ids",
    "supporting_evidence_refs",
    "shared_assumption_ids",
    "assumptions",
    "enabling_conditions",
    "inhibiting_conditions",
    "transmission_pathways",
    "signposts",
    "disconfirming_signposts",
    "falsification_conditions",
    "competing_scenario_ids",
    "divergence_point_ids",
    "uncertainty_notes",
    "temporal_scope",
    "review_state",
    "lifecycle_state",
    "first_created_at_utc",
    "effective_at_utc",
    "latest_reviewed_at_utc",
    "review_provenance",
    "rationale",
    "revision_reason"
  ],
  "controlled_vocabularies": {
    "review_state": ["DRAFT", "CANDIDATE", "UNDER_REVIEW", "ACCEPTED", "REJECTED"],
    "lifecycle_state": ["UNRESOLVED", "ACTIVE", "WEAKENING", "RETIRED", "FALSIFIED", "SUPERSEDED"],
    "assumption_category": ["FACTUAL_STARTING_CONDITION", "STRUCTURAL", "BEHAVIOURAL", "POLICY", "EXTERNAL_DEPENDENCY", "UNRESOLVED"],
    "signpost_effect": ["MORE_COMPATIBLE", "LESS_COMPATIBLE", "DISCRIMINATING"],
    "transmission_epistemic_status": ["CONTEXTUAL", "HYPOTHESISED_TRANSMISSION", "REVIEWED_MECHANISM"],
    "set_lifecycle_state": ["UNRESOLVED", "ACTIVE", "RETIRED", "SUPERSEDED"],
    "temporal_scope_type": ["OPEN_ENDED", "BOUNDED"]
  },
  "scenario_policy": {
    "scenario_sets_are_explicit": true,
    "minimum_competing_members": 2,
    "shared_assumptions_are_distinct_from_evidence": true,
    "divergence_points_are_explicit": true,
    "signposts_are_not_automatically_scored": true,
    "one_favoured_scenario_is_not_authoritative": true,
    "scenario_creation_does_not_mutate_upstream_layers": true
  },
  "revision_policy": {
    "stable_ids_are_preserved_across_revisions": true,
    "each_revision_is_immutable": true,
    "previous_revision_must_remain_present": true,
    "revision_numbers_are_contiguous": true,
    "revision_time_must_strictly_advance": true,
    "first_created_time_remains_stable": true,
    "later_evidence_may_not_rewrite_earlier_scenarios": true,
    "as_of_requires_explicit_utc_input": true
  },
  "upstream_policy": {
    "reviewed_risk_states_are_primary_context": true,
    "reviewed_relationships_and_signals_are_supporting_context": true,
    "immutable_observations_and_evidence_provide_lineage": true,
    "canonical_occurrences_are_context_only": true,
    "raw_monitor_candidates_are_not_evidence": true,
    "rejected_or_withdrawn_upstream_cannot_support_active_scenarios": true,
    "superseded_upstream_requires_historical_context": true
  },
  "forecast_boundary": {
    "probability_prohibited": true,
    "likelihood_prohibited": true,
    "expected_value_prohibited": true,
    "target_value_prohibited": true,
    "predicted_outcome_prohibited": true,
    "forecast_horizon_prohibited": true,
    "winner_or_ranking_prohibited": true
  },
  "population_policy": {
    "production_population_allowed": false,
    "automatic_ingestion_allowed": false,
    "candidate_scenario_storage_allowed": false,
    "synthetic_production_population_allowed": false,
    "public_scenario_projection_allowed": false,
    "reason": "Define and pressure-test competing conditional pathways before any governed Scenario admission transaction."
  },
  "public_projection_policy": {
    "scenario_projection_allowed": false,
    "internal_scenario_count_must_be_zero": true,
    "runtime_or_review_material_allowed": false
  },
  "prohibited_fields": [
    "probability",
    "likelihood",
    "odds",
    "forecast",
    "forecast_horizon",
    "expected_value",
    "target_value",
    "predicted_outcome",
    "prediction_interval",
    "scenario_probability",
    "winner",
    "ranking",
    "rank"
  ]
}

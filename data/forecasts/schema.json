{
  "project": "WORLD SIGNALS",
  "dataset": "REVIEWED_FORECASTS",
  "version": "0.1",
  "architecture_position": "FORECASTS",
  "upstream_layers": [
    "SCENARIOS",
    "RISKS_REGIMES",
    "RELATIONSHIPS",
    "SIGNALS",
    "LIVE_INTELLIGENCE",
    "CANONICAL_REGISTRY"
  ],
  "downstream_layers": ["OUTCOMES", "MODEL_LEARNING"],
  "purpose": "A prospective, review-governed and resolvable claim about an uncertain future outcome; it is not an outcome record or scoring result.",
  "layer_boundary": {
    "canonical_mutation_allowed": false,
    "observation_mutation_allowed": false,
    "signal_mutation_allowed": false,
    "relationship_mutation_allowed": false,
    "risk_state_mutation_allowed": false,
    "scenario_mutation_allowed": false,
    "automatic_forecast_generation_allowed": false,
    "outcome_resolution_allowed": false,
    "forecast_scoring_allowed": false,
    "model_learning_allowed": false,
    "public_forecast_projection_allowed": false
  },
  "required_forecast_fields": [
    "forecast_id",
    "issuance_id",
    "issuance_number",
    "previous_issuance_id",
    "issuance_kind",
    "revision_id",
    "revision_number",
    "previous_revision_id",
    "revision_kind",
    "forecast_type",
    "question",
    "target",
    "forecast_value",
    "issued_at_utc",
    "information_cutoff_at_utc",
    "revision_created_at_utc",
    "horizon",
    "resolution",
    "scenario_references",
    "risk_state_references",
    "signal_references",
    "relationship_references",
    "supporting_observation_ids",
    "supporting_evidence_refs",
    "assumptions",
    "rationale",
    "forecast_provenance",
    "review_state",
    "lifecycle_state",
    "void_reason",
    "voided_at_utc",
    "review_provenance",
    "revision_reason"
  ],
  "controlled_vocabularies": {
    "forecast_type": ["BINARY_EVENT", "CATEGORICAL", "NUMERIC_POINT"],
    "issuance_kind": ["INITIAL", "ANALYTICAL_UPDATE"],
    "revision_kind": ["ORIGINAL", "ADMINISTRATIVE_CORRECTION"],
    "review_state": ["DRAFT", "CANDIDATE", "UNDER_REVIEW", "ACCEPTED", "REJECTED"],
    "lifecycle_state": ["OPEN", "CLOSED_AWAITING_RESOLUTION", "VOID", "SUPERSEDED", "WITHDRAWN"],
    "target_kind": ["EVENT", "MEASURE", "STATE"],
    "horizon_type": ["FIXED_DATE", "DATE_WINDOW"],
    "missing_data_policy": ["VOID_IF_UNAVAILABLE", "USE_FALLBACK_THEN_VOID", "DEFER_UNTIL_SOURCE_AVAILABLE"],
    "cancellation_policy": ["VOID_IF_TARGET_CANCELLED", "RESOLVE_NO_EVENT", "RESOLVE_AS_DEFINED"],
    "vintage_policy": ["NOT_APPLICABLE", "FIRST_OFFICIAL_RELEASE", "REVISED_RELEASE", "FINAL_VINTAGE", "NAMED_VINTAGE"],
    "issuer_type": ["HUMAN_ANALYST", "WORLD_SIGNALS_MODEL", "EXTERNAL_INSTITUTION", "HYBRID_PROCESS"]
  },
  "forecast_policy": {
    "binary_probability_bounds_inclusive": true,
    "categorical_outcomes_must_be_unique": true,
    "categorical_outcomes_must_be_mutually_exclusive": true,
    "categorical_outcomes_must_be_collectively_exhaustive": true,
    "categorical_probability_sum_tolerance": 0.000001,
    "numeric_estimates_must_be_finite": true,
    "numeric_forecasts_require_unit": true,
    "numeric_forecasts_require_vintage_policy": true,
    "qualitative_probability_words_are_not_numeric": true,
    "probability_is_not_inferred_from_confidence": true,
    "forecast_updates_are_independently_scoreable_issuances": true,
    "administrative_corrections_cannot_change_substantive_content": true,
    "question_target_and_resolution_are_immutable": true,
    "outcome_and_scoring_fields_are_deferred": true
  },
  "information_cutoff_policy": {
    "cutoff_must_not_follow_issue_time": true,
    "observation_time_must_not_follow_cutoff": true,
    "evidence_publication_time_must_not_follow_cutoff": true,
    "late_publication_is_not_backdated_to_cutoff": true,
    "event_time_and_publication_time_remain_distinct": true
  },
  "resolution_policy": {
    "resolution_rule_required_at_issuance": true,
    "authoritative_resolution_source_required": true,
    "fallback_source_policy_required": true,
    "missing_data_policy_required": true,
    "cancellation_policy_required": true,
    "numeric_vintage_policy_required": true,
    "outcome_layer_owns_resolution": true,
    "forecast_layer_does_not_store_outcomes": true
  },
  "provenance_policy": {
    "issuer_and_method_required": true,
    "human_review_required_for_accepted_forecast": true,
    "external_forecasts_must_remain_distinct": true,
    "scenario_probability_is_never_inferred": true
  },
  "population_policy": {
    "production_population_allowed": true,
    "automatic_ingestion_allowed": false,
    "candidate_forecast_storage_allowed": false,
    "synthetic_production_population_allowed": false,
    "public_forecast_projection_allowed": false,
    "admission_mode": "REVIEWED_PROSPECTIVE_PILOT_ONLY",
    "pilot_max_forecast_issuances": 5,
    "pilot_requires_explicit_transaction": true,
    "pilot_prohibits_backfill": true,
    "pilot_requires_human_review": true,
    "reason": "Only the bounded, explicit prospective pilot admission transaction may populate production; automatic, synthetic, public and candidate ingestion remain closed."
  },
  "public_projection_policy": {
    "forecast_projection_allowed": false,
    "internal_forecast_count_must_be_zero": true,
    "runtime_or_review_material_allowed": false
  },
  "prohibited_fields": [
    "outcome",
    "resolution_result",
    "resolved_value",
    "score",
    "brier_score",
    "log_loss",
    "calibration",
    "model_learning",
    "scenario_probability",
    "winner",
    "ranking",
    "confidence_interval",
    "prediction_interval",
    "forecast_probability"
  ]
}
